  <Sequence DisplayName="StateMachine" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_CaseCategory" />
      <Variable x:TypeArguments="x:String" Name="v_ComplianceAssessment" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_A" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_B" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_C" />
      <Variable x:TypeArguments="x:String" Name="v_Indicator_X" />
      <Variable x:TypeArguments="x:String" Name="v_Detail_X" />
      <Variable x:TypeArguments="x:Boolean" Name="v_SecondaryIndicator" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <StateMachine DisplayName="EligibilityDecision StateMachine" sap2010:WorkflowViewState.IdRef="StateMachine_SM">
      <StateMachine.InitialState>
        <x:Reference>State_Extract</x:Reference>
      </StateMachine.InitialState>
      <StateMachine.States>

        <State x:Name="State_Extract" DisplayName="Extract from SpecificContent" sap2010:WorkflowViewState.IdRef="State_Extract">
          <State.Entry>
            <ui:MultipleAssign DisplayName="Extract from SpecificContent" sap2010:WorkflowViewState.IdRef="MultipleAssign_Extract">
              <ui:MultipleAssign.AssignOperations>
                <scg:List x:TypeArguments="ui:AssignOperation" Capacity="8">
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_CaseCategory]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_CaseCategory"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_ComplianceAssessment]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_ComplianceAssessment"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_3">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_Attribute_A]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_A"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_4">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_Attribute_B]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_B"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_5">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_Attribute_C]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_C"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_6">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_Indicator_X]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Indicator_X"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_7">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:String">[v_Detail_X]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Detail_X"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                  <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_8">
                    <ui:AssignOperation.To><OutArgument x:TypeArguments="x:Boolean">[v_SecondaryIndicator]</OutArgument></ui:AssignOperation.To>
                    <ui:AssignOperation.Value><InArgument x:TypeArguments="x:Boolean">[CBool(in_TransactionItem.SpecificContent("in_SecondaryIndicator"))]</InArgument></ui:AssignOperation.Value>
                  </ui:AssignOperation>
                </scg:List>
              </ui:MultipleAssign.AssignOperations>
            </ui:MultipleAssign>
          </State.Entry>
          <State.Transitions>
            <Transition DisplayName="&#x2192; Route" sap2010:WorkflowViewState.IdRef="Transition_Extract_Route">
              <Transition.To><x:Reference>State_Route</x:Reference></Transition.To>
            </Transition>
          </State.Transitions>
        </State>

        <State x:Name="State_Route" DisplayName="Route by Category" sap2010:WorkflowViewState.IdRef="State_Route">
          <State.Transitions>
            <Transition DisplayName="SecondaryIndicator &#x2192; Positive" sap2010:WorkflowViewState.IdRef="Transition_Route_Secondary">
              <Transition.Condition>[v_SecondaryIndicator]</Transition.Condition>
              <Transition.To><x:Reference>State_Positive</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Event_A or Event_B &#x2192; RG1" sap2010:WorkflowViewState.IdRef="Transition_Route_RG1">
              <Transition.Condition>[v_CaseCategory = "Event_A" OrElse v_CaseCategory = "Event_B"]</Transition.Condition>
              <Transition.To><x:Reference>State_RG1</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Event_C or Event_D &#x2192; RG2" sap2010:WorkflowViewState.IdRef="Transition_Route_RG2">
              <Transition.Condition>[v_CaseCategory = "Event_C" OrElse v_CaseCategory = "Event_D"]</Transition.Condition>
              <Transition.To><x:Reference>State_RG2</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Unknown CaseCategory &#x2192; Negative" sap2010:WorkflowViewState.IdRef="Transition_Route_UnknownNeg">
              <Transition.Condition>[True]</Transition.Condition>
              <Transition.To><x:Reference>State_Negative</x:Reference></Transition.To>
            </Transition>
          </State.Transitions>
        </State>

        <State x:Name="State_RG1" DisplayName="Rule Group 1: Event_A or Event_B" sap2010:WorkflowViewState.IdRef="State_RG1">
          <State.Transitions>
            <Transition DisplayName="Compliant or empty &#x2192; Positive" sap2010:WorkflowViewState.IdRef="Transition_RG1_Compliant">
              <Transition.Condition>[v_ComplianceAssessment = "Compliant" OrElse String.IsNullOrEmpty(v_ComplianceAssessment)]</Transition.Condition>
              <Transition.To><x:Reference>State_Positive</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Non_Compliant + Attr_A + Attr_BC &#x2192; Positive" sap2010:WorkflowViewState.IdRef="Transition_RG1_NonCompliant">
              <Transition.Condition>[v_ComplianceAssessment = "Non_Compliant" AndAlso (v_Attribute_A = "Verification_not_available" OrElse v_Attribute_A = "Special_case_without_certified_component") AndAlso (v_Attribute_B = "No_or_low_impact" OrElse v_Attribute_C = "No_or_low_impact")]</Transition.Condition>
              <Transition.To><x:Reference>State_Positive</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Otherwise &#x2192; Negative" sap2010:WorkflowViewState.IdRef="Transition_RG1_Neg">
              <Transition.Condition>[True]</Transition.Condition>
              <Transition.To><x:Reference>State_Negative</x:Reference></Transition.To>
            </Transition>
          </State.Transitions>
        </State>

        <State x:Name="State_RG2" DisplayName="Rule Group 2: Event_C or Event_D" sap2010:WorkflowViewState.IdRef="State_RG2">
          <State.Transitions>
            <Transition DisplayName="Indicator_X=Y + Detail_X OK &#x2192; Positive" sap2010:WorkflowViewState.IdRef="Transition_RG2_IX_Y">
              <Transition.Condition>[v_Indicator_X = "Y" AndAlso (v_Detail_X = "Noticeable_irregularity" OrElse String.IsNullOrEmpty(v_Detail_X))]</Transition.Condition>
              <Transition.To><x:Reference>State_Positive</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Indicator_X=N + Compliant or empty &#x2192; Positive" sap2010:WorkflowViewState.IdRef="Transition_RG2_IX_N_Compliant">
              <Transition.Condition>[v_Indicator_X = "N" AndAlso (v_ComplianceAssessment = "Compliant" OrElse String.IsNullOrEmpty(v_ComplianceAssessment))]</Transition.Condition>
              <Transition.To><x:Reference>State_Positive</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Indicator_X=N + Non_Compliant + Attr_A + Attr_BC &#x2192; Positive" sap2010:WorkflowViewState.IdRef="Transition_RG2_IX_N_NonCompliant">
              <Transition.Condition>[v_Indicator_X = "N" AndAlso v_ComplianceAssessment = "Non_Compliant" AndAlso (v_Attribute_A = "Verification_not_available" OrElse v_Attribute_A = "Special_case_without_certified_component") AndAlso (v_Attribute_B = "No_or_low_impact" OrElse v_Attribute_C = "No_or_low_impact")]</Transition.Condition>
              <Transition.To><x:Reference>State_Positive</x:Reference></Transition.To>
            </Transition>
            <Transition DisplayName="Otherwise &#x2192; Negative" sap2010:WorkflowViewState.IdRef="Transition_RG2_Neg">
              <Transition.Condition>[True]</Transition.Condition>
              <Transition.To><x:Reference>State_Negative</x:Reference></Transition.To>
            </Transition>
          </State.Transitions>
        </State>

        <State x:Name="State_Positive" DisplayName="Set Positive" sap2010:WorkflowViewState.IdRef="State_Positive">
          <State.Entry>
            <Assign DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_Positive">
              <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
              <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
            </Assign>
          </State.Entry>
          <State.Transitions>
            <Transition DisplayName="&#x2192; Final" sap2010:WorkflowViewState.IdRef="Transition_Positive_Final">
              <Transition.To><x:Reference>State_Final</x:Reference></Transition.To>
            </Transition>
          </State.Transitions>
        </State>

        <State x:Name="State_Negative" DisplayName="Set Negative" sap2010:WorkflowViewState.IdRef="State_Negative">
          <State.Entry>
            <Assign DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_Negative">
              <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
              <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
            </Assign>
          </State.Entry>
          <State.Transitions>
            <Transition DisplayName="&#x2192; Final" sap2010:WorkflowViewState.IdRef="Transition_Negative_Final">
              <Transition.To><x:Reference>State_Final</x:Reference></Transition.To>
            </Transition>
          </State.Transitions>
        </State>

        <State x:Name="State_Final" DisplayName="Final" IsFinal="True" sap2010:WorkflowViewState.IdRef="State_Final" />

      </StateMachine.States>
    </StateMachine>
  </Sequence>
</Activity>
