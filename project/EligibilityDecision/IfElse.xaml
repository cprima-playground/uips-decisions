      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>GlobalConstantsNamespace</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Data.DataSetExtensions</AssemblyReference>
      <AssemblyReference>System.Drawing</AssemblyReference>
      <AssemblyReference>System.Drawing.Common</AssemblyReference>
      <AssemblyReference>System.Drawing.Primitives</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Net.Mail</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="IfElse" sap2010:Annotation.AnnotationText="Pattern: IfElse&#xD;&#xA;Each branch tests one predicate; the matched leaf assigns the output.&#xD;&#xA;Inputs  (from in_TransactionItem.SpecificContent):&#xD;&#xA;  in_CaseCategory, in_ComplianceAssessment&#xD;&#xA;  in_Attribute_A, in_Attribute_B, in_Attribute_C&#xD;&#xA;  in_Indicator_X, in_Detail_X, in_SecondaryIndicator (Boolean)&#xD;&#xA;Output: out_DecisionValue &#x2014; Positive | Negative" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_CaseCategory" />
      <Variable x:TypeArguments="x:String" Name="v_ComplianceAssessment" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_A" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_B" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_C" />
      <Variable x:TypeArguments="x:String" Name="v_Indicator_X" />
      <Variable x:TypeArguments="x:String" Name="v_Detail_X" />
      <Variable x:TypeArguments="x:Boolean" Name="v_SecondaryIndicator" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:MultipleAssign DisplayName="Extract from SpecificContent" sap2010:Annotation.AnnotationText="Extracts all typed inputs from SpecificContent into local variables.&#xD;&#xA;SecondaryIndicator is stored as Boolean; all others as String." sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="8">
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_CaseCategory]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_CaseCategory"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_ComplianceAssessment]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_ComplianceAssessment"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_3">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Attribute_A]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_A"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_4">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Attribute_B]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_B"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_5">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Attribute_C]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_C"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_6">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Indicator_X]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Indicator_X"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_7">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Detail_X]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Detail_X"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_8">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Boolean">[v_SecondaryIndicator]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Boolean">[CBool(in_TransactionItem.SpecificContent("in_SecondaryIndicator"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>

    <!-- SecondaryIndicator overrides everything -->
    <If DisplayName="SecondaryIndicator = True?" sap2010:Annotation.AnnotationText="Universal override: SecondaryIndicator = True &#x2192; always Positive,&#xD;&#xA;regardless of CaseCategory or any other field.&#xD;&#xA;Evaluated first so it short-circuits both rule groups." sap2010:WorkflowViewState.IdRef="If_Secondary">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[v_SecondaryIndicator]</InArgument>
      </If.Condition>
      <If.Then>
        <Assign DisplayName="Positive" sap2010:Annotation.AnnotationText="SecondaryIndicator override fires &#x2192; Positive." sap2010:WorkflowViewState.IdRef="Assign_Secondary_Pos">
          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
        </Assign>
      </If.Then>
      <If.Else>

        <!-- Route by CaseCategory -->
        <If DisplayName="CaseCategory = Event_A or Event_B?" sap2010:Annotation.AnnotationText="Dispatch: CaseCategory &#x2208; {Event_A, Event_B} &#x2192; Rule Group 1 branch." sap2010:WorkflowViewState.IdRef="If_RG1">
          <If.Condition>
            <InArgument x:TypeArguments="x:Boolean">[v_CaseCategory = "Event_A" OrElse v_CaseCategory = "Event_B"]</InArgument>
          </If.Condition>
          <If.Then>

            <!-- RG1: ComplianceAssessment = Compliant or empty? -->
            <If DisplayName="ComplianceAssessment = Compliant or empty?" sap2010:Annotation.AnnotationText="RG1 positive path: ComplianceAssessment = Compliant OR empty.&#xD;&#xA;Empty string is a sentinel meaning &quot;assessment not yet available&quot; &#x2014; treated as Positive." sap2010:WorkflowViewState.IdRef="If_RG1_CA_Pos">
              <If.Condition>
                <InArgument x:TypeArguments="x:Boolean">[v_ComplianceAssessment = "Compliant" OrElse String.IsNullOrEmpty(v_ComplianceAssessment)]</InArgument>
              </If.Condition>
              <If.Then>
                <Assign DisplayName="Positive" sap2010:Annotation.AnnotationText="RG1: Compliant or empty ComplianceAssessment &#x2192; Positive." sap2010:WorkflowViewState.IdRef="Assign_RG1_CA_Pos">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
                </Assign>
              </If.Then>
              <If.Else>

                <!-- RG1: ComplianceAssessment = Non_Compliant? -->
                <If DisplayName="ComplianceAssessment = Non_Compliant?" sap2010:Annotation.AnnotationText="RG1: ComplianceAssessment = Non_Compliant &#x2014; enter attribute evaluation." sap2010:WorkflowViewState.IdRef="If_RG1_NonCompliant">
                  <If.Condition>
                    <InArgument x:TypeArguments="x:Boolean">[v_ComplianceAssessment = "Non_Compliant"]</InArgument>
                  </If.Condition>
                  <If.Then>

                    <!-- RG1: Attribute_A in allowed set? -->
                    <If DisplayName="Attribute_A = Verif_NA or Special_case?" sap2010:Annotation.AnnotationText="RG1 Non_Compliant: Attribute_A must be one of two special values&#xD;&#xA;that indicate mitigating circumstances:&#xD;&#xA;  Verification_not_available&#xD;&#xA;  Special_case_without_certified_component" sap2010:WorkflowViewState.IdRef="If_RG1_AttrA">
                      <If.Condition>
                        <InArgument x:TypeArguments="x:Boolean">[v_Attribute_A = "Verification_not_available" OrElse v_Attribute_A = "Special_case_without_certified_component"]</InArgument>
                      </If.Condition>
                      <If.Then>

                        <!-- RG1: Attribute_B or Attribute_C = No_or_low_impact? -->
                        <If DisplayName="Attribute_B or Attribute_C = No_or_low_impact?" sap2010:Annotation.AnnotationText="[NEEDLE &#x2014; deepest decision point in RG1]&#xD;&#xA;RG1 Non_Compliant + special Attribute_A:&#xD;&#xA;  Positive if Attribute_B = No_or_low_impact&#xD;&#xA;           OR Attribute_C = No_or_low_impact&#xD;&#xA;Open question #1: is this OR or AND? Currently implemented as OR.&#xD;&#xA;&#xD;&#xA;#cb39fe" sap2010:WorkflowViewState.IdRef="If_RG1_AttrBC">
                          <If.Condition>
                            <InArgument x:TypeArguments="x:Boolean">[v_Attribute_B = "No_or_low_impact" OrElse v_Attribute_C = "No_or_low_impact"]</InArgument>
                          </If.Condition>
                          <If.Then>
                            <Assign DisplayName="Positive" sap2010:Annotation.AnnotationText="RG1 Non_Compliant + special Attribute_A + low-impact Attribute_BC &#x2192; Positive." sap2010:WorkflowViewState.IdRef="Assign_RG1_AttrBC_Pos">
                              <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                              <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
                            </Assign>
                          </If.Then>
                          <If.Else>
                            <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG1 Non_Compliant + special Attribute_A + NO low-impact Attribute_BC &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG1_AttrBC_Neg">
                              <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                              <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                            </Assign>
                          </If.Else>
                        </If>

                      </If.Then>
                      <If.Else>
                        <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG1 Non_Compliant + Attribute_A NOT in special values &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG1_AttrA_Neg">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>

                  </If.Then>
                  <If.Else>
                    <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG1: ComplianceAssessment is not Compliant, empty, or Non_Compliant&#xD;&#xA;(unexpected value) &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG1_CA_Neg">
                      <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                    </Assign>
                  </If.Else>
                </If>

              </If.Else>
            </If>

          </If.Then>
          <If.Else>

            <!-- Route: Event_C or Event_D? -->
            <If DisplayName="CaseCategory = Event_C or Event_D?" sap2010:Annotation.AnnotationText="Dispatch: CaseCategory &#x2208; {Event_C, Event_D} &#x2192; Rule Group 2 branch." sap2010:WorkflowViewState.IdRef="If_RG2">
              <If.Condition>
                <InArgument x:TypeArguments="x:Boolean">[v_CaseCategory = "Event_C" OrElse v_CaseCategory = "Event_D"]</InArgument>
              </If.Condition>
              <If.Then>

                <!-- RG2: Indicator_X = Y? -->
                <If DisplayName="Indicator_X = Y?" sap2010:Annotation.AnnotationText="RG2: Indicator_X = Y &#x2192; evaluate Detail_X." sap2010:WorkflowViewState.IdRef="If_RG2_IX_Y">
                  <If.Condition>
                    <InArgument x:TypeArguments="x:Boolean">[v_Indicator_X = "Y"]</InArgument>
                  </If.Condition>
                  <If.Then>

                    <!-- RG2: Detail_X = Noticeable_irregularity or empty? -->
                    <If DisplayName="Detail_X = Noticeable_irregularity or empty?" sap2010:Annotation.AnnotationText="RG2 Indicator_X=Y: Positive if Detail_X = Noticeable_irregularity OR empty.&#xD;&#xA;Empty Detail_X is a sentinel meaning &quot;irregularity present but not yet classified&quot;." sap2010:WorkflowViewState.IdRef="If_RG2_DX">
                      <If.Condition>
                        <InArgument x:TypeArguments="x:Boolean">[v_Detail_X = "Noticeable_irregularity" OrElse String.IsNullOrEmpty(v_Detail_X)]</InArgument>
                      </If.Condition>
                      <If.Then>
                        <Assign DisplayName="Positive" sap2010:Annotation.AnnotationText="RG2 Indicator_X=Y + acceptable Detail_X &#x2192; Positive." sap2010:WorkflowViewState.IdRef="Assign_RG2_DX_Pos">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
                        </Assign>
                      </If.Then>
                      <If.Else>
                        <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG2 Indicator_X=Y + unrecognised Detail_X &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG2_DX_Neg">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>

                  </If.Then>
                  <If.Else>

                    <!-- RG2: Indicator_X = N? -->
                    <If DisplayName="Indicator_X = N?" sap2010:Annotation.AnnotationText="RG2: Indicator_X = N &#x2192; apply same compliance logic as Rule Group 1." sap2010:WorkflowViewState.IdRef="If_RG2_IX_N">
                      <If.Condition>
                        <InArgument x:TypeArguments="x:Boolean">[v_Indicator_X = "N"]</InArgument>
                      </If.Condition>
                      <If.Then>

                        <!-- RG2/N: ComplianceAssessment = Compliant or empty? -->
                        <If DisplayName="ComplianceAssessment = Compliant or empty?" sap2010:Annotation.AnnotationText="RG2 Indicator_X=N: ComplianceAssessment = Compliant or empty &#x2192; Positive." sap2010:WorkflowViewState.IdRef="If_RG2_CA_Pos">
                          <If.Condition>
                            <InArgument x:TypeArguments="x:Boolean">[v_ComplianceAssessment = "Compliant" OrElse String.IsNullOrEmpty(v_ComplianceAssessment)]</InArgument>
                          </If.Condition>
                          <If.Then>
                            <Assign DisplayName="Positive" sap2010:Annotation.AnnotationText="RG2 Indicator_X=N + Compliant or empty &#x2192; Positive." sap2010:WorkflowViewState.IdRef="Assign_RG2_CA_Pos">
                              <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                              <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
                            </Assign>
                          </If.Then>
                          <If.Else>

                            <!-- RG2/N: ComplianceAssessment = Non_Compliant? -->
                            <If DisplayName="ComplianceAssessment = Non_Compliant?" sap2010:Annotation.AnnotationText="RG2 Indicator_X=N: Non_Compliant &#x2014; enter attribute evaluation (mirrors RG1)." sap2010:WorkflowViewState.IdRef="If_RG2_NonCompliant">
                              <If.Condition>
                                <InArgument x:TypeArguments="x:Boolean">[v_ComplianceAssessment = "Non_Compliant"]</InArgument>
                              </If.Condition>
                              <If.Then>

                                <!-- RG2/N: Attribute_A in allowed set? -->
                                <If DisplayName="Attribute_A = Verif_NA or Special_case?" sap2010:Annotation.AnnotationText="RG2 Non_Compliant: Attribute_A must be one of the two special values&#xD;&#xA;(same condition as RG1)." sap2010:WorkflowViewState.IdRef="If_RG2_AttrA">
                                  <If.Condition>
                                    <InArgument x:TypeArguments="x:Boolean">[v_Attribute_A = "Verification_not_available" OrElse v_Attribute_A = "Special_case_without_certified_component"]</InArgument>
                                  </If.Condition>
                                  <If.Then>

                                    <!-- RG2/N: Attribute_B or Attribute_C = No_or_low_impact? -->
                                    <If DisplayName="Attribute_B or Attribute_C = No_or_low_impact?" sap2010:Annotation.AnnotationText="RG2 Non_Compliant + special Attribute_A:&#xD;&#xA;  Positive if Attribute_B = No_or_low_impact OR Attribute_C = No_or_low_impact.&#xD;&#xA;Open question #1: OR or AND? Currently implemented as OR." sap2010:WorkflowViewState.IdRef="If_RG2_AttrBC">
                                      <If.Condition>
                                        <InArgument x:TypeArguments="x:Boolean">[v_Attribute_B = "No_or_low_impact" OrElse v_Attribute_C = "No_or_low_impact"]</InArgument>
                                      </If.Condition>
                                      <If.Then>
                                        <Assign DisplayName="Positive" sap2010:Annotation.AnnotationText="RG2 Non_Compliant + special Attribute_A + low-impact Attribute_BC &#x2192; Positive." sap2010:WorkflowViewState.IdRef="Assign_RG2_AttrBC_Pos">
                                          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                                          <Assign.Value><InArgument x:TypeArguments="x:String">["Positive"]</InArgument></Assign.Value>
                                        </Assign>
                                      </If.Then>
                                      <If.Else>
                                        <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG2 Non_Compliant + special Attribute_A + NO low-impact Attribute_BC &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG2_AttrBC_Neg">
                                          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                                          <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                                        </Assign>
                                      </If.Else>
                                    </If>

                                  </If.Then>
                                  <If.Else>
                                    <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG2 Non_Compliant + Attribute_A NOT in special values &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG2_AttrA_Neg">
                                      <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                                      <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                                    </Assign>
                                  </If.Else>
                                </If>

                              </If.Then>
                              <If.Else>
                                <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG2 Indicator_X=N + unexpected ComplianceAssessment value &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG2_CA_Neg">
                                  <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                                  <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                                </Assign>
                              </If.Else>
                            </If>

                          </If.Else>
                        </If>

                      </If.Then>
                      <If.Else>
                        <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="RG2: Indicator_X is neither Y nor N (unexpected value) &#x2192; Negative." sap2010:WorkflowViewState.IdRef="Assign_RG2_IX_Neg">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>

                  </If.Else>
                </If>

              </If.Then>
              <If.Else>
                <Assign DisplayName="Negative" sap2010:Annotation.AnnotationText="CaseCategory is not Event_A, B, C, or D (unexpected value) &#x2192; Negative.&#xD;&#xA;Default-deny: unrecognised categories do not produce Positive." sap2010:WorkflowViewState.IdRef="Assign_UnknownCategory">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">["Negative"]</InArgument></Assign.Value>
                </Assign>
              </If.Else>
            </If>

          </If.Else>
        </If>

      </If.Else>
    </If>

  </Sequence>
</Activity>
