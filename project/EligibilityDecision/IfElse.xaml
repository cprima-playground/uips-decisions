      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Pattern: IfElse&#xA;Each branch tests one predicate; the matched leaf assigns the output.&#xA;Inputs  (from in_TransactionItem.SpecificContent):&#xA;  in_CaseCategory, in_ComplianceAssessment&#xA;  in_Attribute_A, in_Attribute_B, in_Attribute_C&#xA;  in_Indicator_X, in_Detail_X, in_SecondaryIndicator (Boolean)&#xA;Output: out_DecisionValue — Positive | Negative" DisplayName="IfElse" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_CaseCategory" />
      <Variable x:TypeArguments="x:String" Name="v_ComplianceAssessment" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_A" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_B" />
      <Variable x:TypeArguments="x:String" Name="v_Attribute_C" />
      <Variable x:TypeArguments="x:String" Name="v_Indicator_X" />
      <Variable x:TypeArguments="x:String" Name="v_Detail_X" />
      <Variable x:TypeArguments="x:Boolean" Name="v_SecondaryIndicator" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:MultipleAssign sap2010:Annotation.AnnotationText="Extracts all typed inputs from SpecificContent into local variables.&#xA;SecondaryIndicator is stored as Boolean; all others as String." DisplayName="Extract from SpecificContent" sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="8">
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_CaseCategory]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_CaseCategory"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_ComplianceAssessment]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_ComplianceAssessment"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_3">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Attribute_A]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_A"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_4">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Attribute_B]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_B"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_5">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Attribute_C]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Attribute_C"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_6">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Indicator_X]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Indicator_X"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_7">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[v_Detail_X]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Convert.ToString(in_TransactionItem.SpecificContent("in_Detail_X"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_8">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Boolean">[v_SecondaryIndicator]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Boolean">[CBool(in_TransactionItem.SpecificContent("in_SecondaryIndicator"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
    <If sap2010:Annotation.AnnotationText="[RULE]&#xA;Universal override: SecondaryIndicator = True → always Positive,&#xA;regardless of CaseCategory or any other field.&#xA;Evaluated first so it short-circuits both rule groups." Condition="[v_SecondaryIndicator]" DisplayName="SecondaryIndicator = True?" sap2010:WorkflowViewState.IdRef="If_Secondary">
      <If.Then>
        <Assign sap2010:Annotation.AnnotationText="SecondaryIndicator override fires → Positive." DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_Secondary_Pos">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
      <If.Else>
        <If sap2010:Annotation.AnnotationText="Dispatch: CaseCategory ∈ {Event_A, Event_B} → Rule Group 1 branch." Condition="[v_CaseCategory = &quot;Event_A&quot; OrElse v_CaseCategory = &quot;Event_B&quot;]" DisplayName="CaseCategory = Event_A or Event_B?" sap2010:WorkflowViewState.IdRef="If_RG1">
          <If.Then>
            <If sap2010:Annotation.AnnotationText="[SENTINEL]&#xA;RG1 positive path: ComplianceAssessment = Compliant OR empty.&#xA;Empty string is a sentinel meaning &quot;assessment not yet available&quot; — treated as Positive." Condition="[v_ComplianceAssessment = &quot;Compliant&quot; OrElse String.IsNullOrEmpty(v_ComplianceAssessment)]" DisplayName="ComplianceAssessment = Compliant or empty?" sap2010:WorkflowViewState.IdRef="If_RG1_CA_Pos">
              <If.Then>
                <Assign sap2010:Annotation.AnnotationText="RG1: Compliant or empty ComplianceAssessment → Positive." DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_RG1_CA_Pos">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Then>
              <If.Else>
                <If sap2010:Annotation.AnnotationText="RG1: ComplianceAssessment = Non_Compliant — enter attribute evaluation." Condition="[v_ComplianceAssessment = &quot;Non_Compliant&quot;]" DisplayName="ComplianceAssessment = Non_Compliant?" sap2010:WorkflowViewState.IdRef="If_RG1_NonCompliant">
                  <If.Then>
                    <If sap2010:Annotation.AnnotationText="[RULE]&#xA;RG1 Non_Compliant: Attribute_A must be one of two special values&#xA;that indicate mitigating circumstances:&#xA;  Verification_not_available&#xA;  Special_case_without_certified_component" Condition="[v_Attribute_A = &quot;Verification_not_available&quot; OrElse v_Attribute_A = &quot;Special_case_without_certified_component&quot;]" DisplayName="Attribute_A = Verif_NA or Special_case?" sap2010:WorkflowViewState.IdRef="If_RG1_AttrA">
                      <If.Then>
                        <If sap2010:Annotation.AnnotationText="[OPEN]&#xA;RG1 Non_Compliant + special Attribute_A:&#xA;  Positive if Attribute_B = No_or_low_impact&#xA;           OR Attribute_C = No_or_low_impact&#xA;Open question #1: is this OR or AND? Currently implemented as OR." Condition="[v_Attribute_B = &quot;No_or_low_impact&quot; OrElse v_Attribute_C = &quot;No_or_low_impact&quot;]" DisplayName="Attribute_B or Attribute_C = No_or_low_impact?" sap2010:WorkflowViewState.IdRef="If_RG1_AttrBC">
                          <If.Then>
                            <Assign sap2010:Annotation.AnnotationText="RG1 Non_Compliant + special Attribute_A + low-impact Attribute_BC → Positive." DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_RG1_AttrBC_Pos">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
                              </Assign.Value>
                            </Assign>
                          </If.Then>
                          <If.Else>
                            <Assign sap2010:Annotation.AnnotationText="RG1 Non_Compliant + special Attribute_A + NO low-impact Attribute_BC → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG1_AttrBC_Neg">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                              </Assign.Value>
                            </Assign>
                          </If.Else>
                        </If>
                      </If.Then>
                      <If.Else>
                        <Assign sap2010:Annotation.AnnotationText="RG1 Non_Compliant + Attribute_A NOT in special values → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG1_AttrA_Neg">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>
                  </If.Then>
                  <If.Else>
                    <Assign sap2010:Annotation.AnnotationText="RG1: ComplianceAssessment is not Compliant, empty, or Non_Compliant&#xA;(unexpected value) → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG1_CA_Neg">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </If.Else>
                </If>
              </If.Else>
            </If>
          </If.Then>
          <If.Else>
            <If sap2010:Annotation.AnnotationText="Dispatch: CaseCategory ∈ {Event_C, Event_D} → Rule Group 2 branch." Condition="[v_CaseCategory = &quot;Event_C&quot; OrElse v_CaseCategory = &quot;Event_D&quot;]" DisplayName="CaseCategory = Event_C or Event_D?" sap2010:WorkflowViewState.IdRef="If_RG2">
              <If.Then>
                <If sap2010:Annotation.AnnotationText="RG2: Indicator_X = Y → evaluate Detail_X." Condition="[v_Indicator_X = &quot;Y&quot;]" DisplayName="Indicator_X = Y?" sap2010:WorkflowViewState.IdRef="If_RG2_IX_Y">
                  <If.Then>
                    <If sap2010:Annotation.AnnotationText="[SENTINEL]&#xA;RG2 Indicator_X=Y: Positive if Detail_X = Noticeable_irregularity OR empty.&#xA;Empty Detail_X is a sentinel meaning &quot;irregularity present but not yet classified&quot;." Condition="[v_Detail_X = &quot;Noticeable_irregularity&quot; OrElse String.IsNullOrEmpty(v_Detail_X)]" DisplayName="Detail_X = Noticeable_irregularity or empty?" sap2010:WorkflowViewState.IdRef="If_RG2_DX">
                      <If.Then>
                        <Assign sap2010:Annotation.AnnotationText="RG2 Indicator_X=Y + acceptable Detail_X → Positive." DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_RG2_DX_Pos">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </If.Then>
                      <If.Else>
                        <Assign sap2010:Annotation.AnnotationText="RG2 Indicator_X=Y + unrecognised Detail_X → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG2_DX_Neg">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>
                  </If.Then>
                  <If.Else>
                    <If sap2010:Annotation.AnnotationText="RG2: Indicator_X = N → apply same compliance logic as Rule Group 1." Condition="[v_Indicator_X = &quot;N&quot;]" DisplayName="Indicator_X = N?" sap2010:WorkflowViewState.IdRef="If_RG2_IX_N">
                      <If.Then>
                        <If sap2010:Annotation.AnnotationText="RG2 Indicator_X=N: ComplianceAssessment = Compliant or empty → Positive." Condition="[v_ComplianceAssessment = &quot;Compliant&quot; OrElse String.IsNullOrEmpty(v_ComplianceAssessment)]" DisplayName="ComplianceAssessment = Compliant or empty?" sap2010:WorkflowViewState.IdRef="If_RG2_CA_Pos">
                          <If.Then>
                            <Assign sap2010:Annotation.AnnotationText="RG2 Indicator_X=N + Compliant or empty → Positive." DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_RG2_CA_Pos">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
                              </Assign.Value>
                            </Assign>
                          </If.Then>
                          <If.Else>
                            <If sap2010:Annotation.AnnotationText="RG2 Indicator_X=N: Non_Compliant — enter attribute evaluation (mirrors RG1)." Condition="[v_ComplianceAssessment = &quot;Non_Compliant&quot;]" DisplayName="ComplianceAssessment = Non_Compliant?" sap2010:WorkflowViewState.IdRef="If_RG2_NonCompliant">
                              <If.Then>
                                <If sap2010:Annotation.AnnotationText="[RULE]&#xA;RG2 Non_Compliant: Attribute_A must be one of the two special values&#xA;(same condition as RG1)." Condition="[v_Attribute_A = &quot;Verification_not_available&quot; OrElse v_Attribute_A = &quot;Special_case_without_certified_component&quot;]" DisplayName="Attribute_A = Verif_NA or Special_case?" sap2010:WorkflowViewState.IdRef="If_RG2_AttrA">
                                  <If.Then>
                                    <If sap2010:Annotation.AnnotationText="[OPEN]&#xA;RG2 Non_Compliant + special Attribute_A:&#xA;  Positive if Attribute_B = No_or_low_impact OR Attribute_C = No_or_low_impact.&#xA;Open question #1: OR or AND? Currently implemented as OR." Condition="[v_Attribute_B = &quot;No_or_low_impact&quot; OrElse v_Attribute_C = &quot;No_or_low_impact&quot;]" DisplayName="Attribute_B or Attribute_C = No_or_low_impact?" sap2010:WorkflowViewState.IdRef="If_RG2_AttrBC">
                                      <If.Then>
                                        <Assign sap2010:Annotation.AnnotationText="RG2 Non_Compliant + special Attribute_A + low-impact Attribute_BC → Positive." DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_RG2_AttrBC_Pos">
                                          <Assign.To>
                                            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                                          </Assign.To>
                                          <Assign.Value>
                                            <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
                                          </Assign.Value>
                                        </Assign>
                                      </If.Then>
                                      <If.Else>
                                        <Assign sap2010:Annotation.AnnotationText="RG2 Non_Compliant + special Attribute_A + NO low-impact Attribute_BC → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG2_AttrBC_Neg">
                                          <Assign.To>
                                            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                                          </Assign.To>
                                          <Assign.Value>
                                            <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                                          </Assign.Value>
                                        </Assign>
                                      </If.Else>
                                    </If>
                                  </If.Then>
                                  <If.Else>
                                    <Assign sap2010:Annotation.AnnotationText="RG2 Non_Compliant + Attribute_A NOT in special values → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG2_AttrA_Neg">
                                      <Assign.To>
                                        <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                                      </Assign.To>
                                      <Assign.Value>
                                        <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                                      </Assign.Value>
                                    </Assign>
                                  </If.Else>
                                </If>
                              </If.Then>
                              <If.Else>
                                <Assign sap2010:Annotation.AnnotationText="RG2 Indicator_X=N + unexpected ComplianceAssessment value → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG2_CA_Neg">
                                  <Assign.To>
                                    <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                                  </Assign.To>
                                  <Assign.Value>
                                    <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                                  </Assign.Value>
                                </Assign>
                              </If.Else>
                            </If>
                          </If.Else>
                        </If>
                      </If.Then>
                      <If.Else>
                        <Assign sap2010:Annotation.AnnotationText="RG2: Indicator_X is neither Y nor N (unexpected value) → Negative." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_RG2_IX_Neg">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>
                  </If.Else>
                </If>
              </If.Then>
              <If.Else>
                <Assign sap2010:Annotation.AnnotationText="[RULE]&#xA;CaseCategory is not Event_A, B, C, or D (unexpected value) → Negative.&#xA;Default-deny: unrecognised categories do not produce Positive." DisplayName="Negative" sap2010:WorkflowViewState.IdRef="Assign_UnknownCategory">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Else>
            </If>
          </If.Else>
        </If>
      </If.Else>
    </If>
  </Sequence>
</Activity>