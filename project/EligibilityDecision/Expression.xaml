    <If sap2010:Annotation.AnnotationText="[RULE]&#xA;Condition encodes the full Rule Group 1 logic in one expression:&#xA;  (CaseCategory ∈ RG1)&#xA;  AND (SecondaryIndicator&#xA;       OR ComplianceAssessment = Compliant&#xA;       OR ComplianceAssessment = empty&#xA;       OR (Non_Compliant AND special Attribute_A&#xA;           AND (Attribute_B OR Attribute_C = No_or_low_impact)))&#xA;Open question #1 applies to the Attribute_BC sub-expression (OR vs AND)." Condition="[(v_CaseCategory = &quot;Event_A&quot; OrElse v_CaseCategory = &quot;Event_B&quot;) AndAlso (v_SecondaryIndicator OrElse v_ComplianceAssessment = &quot;Compliant&quot; OrElse String.IsNullOrEmpty(v_ComplianceAssessment) OrElse (v_ComplianceAssessment = &quot;Non_Compliant&quot; AndAlso (v_Attribute_A = &quot;Verification_not_available&quot; OrElse v_Attribute_A = &quot;Special_case_without_certified_component&quot;) AndAlso (v_Attribute_B = &quot;No_or_low_impact&quot; OrElse v_Attribute_C = &quot;No_or_low_impact&quot;)))]" DisplayName="Rule Group 1: Event_A or Event_B" sap2010:WorkflowViewState.IdRef="If_RG1">
