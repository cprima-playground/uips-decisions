    </If>
    <If sap2010:Annotation.AnnotationText="[RULE]&#xA;Condition encodes the full Rule Group 2 logic in one expression:&#xA;  (CaseCategory ∈ RG2)&#xA;  AND (SecondaryIndicator&#xA;       OR (Indicator_X=Y AND (Detail_X = Noticeable_irregularity OR empty))&#xA;       OR (Indicator_X=N AND (Compliant OR empty&#xA;           OR (Non_Compliant AND special Attribute_A&#xA;               AND (Attribute_B OR Attribute_C = No_or_low_impact)))))&#xA;Mirrors RG1 compliance sub-logic for Indicator_X=N branch." Condition="[(v_CaseCategory = &quot;Event_C&quot; OrElse v_CaseCategory = &quot;Event_D&quot;) AndAlso (v_SecondaryIndicator OrElse (v_Indicator_X = &quot;Y&quot; AndAlso (v_Detail_X = &quot;Noticeable_irregularity&quot; OrElse String.IsNullOrEmpty(v_Detail_X))) OrElse (v_Indicator_X = &quot;N&quot; AndAlso (v_ComplianceAssessment = &quot;Compliant&quot; OrElse String.IsNullOrEmpty(v_ComplianceAssessment) OrElse (v_ComplianceAssessment = &quot;Non_Compliant&quot; AndAlso (v_Attribute_A = &quot;Verification_not_available&quot; OrElse v_Attribute_A = &quot;Special_case_without_certified_component&quot;) AndAlso (v_Attribute_B = &quot;No_or_low_impact&quot; OrElse v_Attribute_C = &quot;No_or_low_impact&quot;)))))]" DisplayName="Rule Group 2: Event_C or Event_D" sap2010:WorkflowViewState.IdRef="If_RG2">
