            <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">["Positive"]</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
    </If>
    <If DisplayName="Rule Group 2: Event_C or Event_D" sap2010:WorkflowViewState.IdRef="If_RG2">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[(v_CaseCategory = "Event_C" OrElse v_CaseCategory = "Event_D") AndAlso (v_SecondaryIndicator OrElse (v_Indicator_X = "Y" AndAlso (v_Detail_X = "Noticeable_irregularity" OrElse String.IsNullOrEmpty(v_Detail_X))) OrElse (v_Indicator_X = "N" AndAlso (v_ComplianceAssessment = "Compliant" OrElse String.IsNullOrEmpty(v_ComplianceAssessment) OrElse (v_ComplianceAssessment = "Non_Compliant" AndAlso (v_Attribute_A = "Verification_not_available" OrElse v_Attribute_A = "Special_case_without_certified_component") AndAlso (v_Attribute_B = "No_or_low_impact" OrElse v_Attribute_C = "No_or_low_impact")))))]</InArgument>
