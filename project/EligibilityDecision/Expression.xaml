      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
    <Assign DisplayName="Default: Negative" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_DecisionValue]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Negative"]</InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="Rule Group 1: Event_A or Event_B" sap2010:WorkflowViewState.IdRef="If_RG1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[(v_CaseCategory = "Event_A" OrElse v_CaseCategory = "Event_B") AndAlso (v_SecondaryIndicator OrElse v_ComplianceAssessment = "Compliant" OrElse String.IsNullOrEmpty(v_ComplianceAssessment) OrElse (v_ComplianceAssessment = "Non_Compliant" AndAlso (v_Attribute_A = "Verification_not_available" OrElse v_Attribute_A = "Special_case_without_certified_component") AndAlso (v_Attribute_B = "No_or_low_impact" OrElse v_Attribute_C = "No_or_low_impact")))]</InArgument>
      </If.Condition>
      <If.Then>
        <Assign DisplayName="Positive" sap2010:WorkflowViewState.IdRef="Assign_RG1_Positive">
